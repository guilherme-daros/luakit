@PACKAGE_INIT@

# FindLua54.cmake is installed alongside this file, so a consumer does not need
# it on their own module path.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Lua54)

list(REMOVE_ITEM CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include("${CMAKE_CURRENT_LIST_DIR}/luakit-targets.cmake")

check_required_components(luakit)
